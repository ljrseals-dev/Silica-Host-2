{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "noUncheckedIndexedAccess": false, "noImplicitOverride": true, "noFallthroughCasesInSwitch": true,
    "noEmit": true, "skipLibCheck": true, "types": ["node"], "isolatedModules": true
  },
  "include": ["src", "tests", "scripts"]
}

// Freestanding shim: the subset of <bit> that silica uses (endian, rotr, countl_zero).
#pragma once
#include <stdint.h>
namespace std {
enum class endian { little = __ORDER_LITTLE_ENDIAN__, big = __ORDER_BIG_ENDIAN__, native = __BYTE_ORDER__ };
template <class T> constexpr int countl_zero(T x) noexcept {
  constexpr int digits = sizeof(T) * 8;
  if (x == 0) return digits;
  if constexpr (sizeof(T) <= 4) return __builtin_clz(static_cast<unsigned>(x)) - (32 - digits);
  else return __builtin_clzll(static_cast<unsigned long long>(x));
}
template <class T> constexpr T rotr(T x, int s) noexcept {
  constexpr int digits = sizeof(T) * 8;
  const int r = s & (digits - 1);
  return r == 0 ? x : static_cast<T>((x >> r) | (x << (digits - r)));
}
}
